diff --git a/iokit/IOKit/graphics/IOGraphicsDevice.h b/iokit/IOKit/graphics/IOGraphicsDevice.h
new file mode 100644
--- /dev/null
+++ b/iokit/IOKit/graphics/IOGraphicsDevice.h
@@ -0,0 +1,20 @@
+/*
+ * LIUQIN: minimal IOGraphicsDevice.h.
+ *
+ * IOHIDSystem.h includes <IOKit/graphics/IOGraphicsDevice.h> for the display
+ * device it talks to on macOS. This tree has no IOGraphics family, and the
+ * vendored IOHIDDevice.cpp only needs the include to resolve: nothing in the
+ * digitizer path touches a graphics device. Declaring the class forward is
+ * enough for every use in the files we compile.
+ */
+#ifndef LIUQIN_IOGRAPHICSDEVICE_STUB_H
+#define LIUQIN_IOGRAPHICSDEVICE_STUB_H
+
+#include <IOKit/IOService.h>
+
+class IOGraphicsDevice : public IOService
+{
+	OSDeclareDefaultStructors(IOGraphicsDevice)
+};
+
+#endif /* LIUQIN_IOGRAPHICSDEVICE_STUB_H */

