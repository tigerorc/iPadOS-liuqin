+
+#ifndef _DEV_EV_TYPES_H
+#define _DEV_EV_TYPES_H
+
+#include <mach/boolean.h>
+#include <libkern/OSAtomic.h>
+#include <IOKit/graphics/IOGraphicsTypes.h>
+
+// This should be removed, but is being used by others
