+  virtual void setAlphaLockFeedback(bool val);
+  virtual void setNumLockFeedback(bool val);
+  virtual UInt32 maxKeyCodes();
+
+
+private:
+  virtual bool resetKeyboard();
+  virtual void scheduleAutoRepeat();
