+//---------------------------------------------------------------------------
+// Query whether a client has an open on the interface.
+
+bool IOHIDDevice::handleIsOpen(const IOService * client) const
+{
+    if (client)
+        return _clientSet->containsObject(client);
+    else
+        return (_clientSet->getCount() > 0);
+}
