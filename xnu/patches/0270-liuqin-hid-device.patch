+#else
+enum
+{
+	kHIDSuccess						= 0,
+	
+/* HID assigned error numbers are -13949 .. -13900 */
+	kHIDBaseError					= -13950,
+
+	kHIDNullStateErr,
+	kHIDBufferTooSmallErr,
+	kHIDValueOutOfRangeErr,
+	kHIDUsageNotFoundErr,
