+bool IOHIDElementPrivate::init( IOHIDElementContainer * owner, IOHIDElementType type )
+{
+	if ( ( super::init() != true ) || ( owner == 0 ) )
+    {
+        return false;
+    }
+
+    _owner = owner;
+    _type  = type;
+    _reportSize = 0;
