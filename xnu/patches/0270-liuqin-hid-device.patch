+#define NX_SUBTYPE_AUX_CONTROL_BUTTONS		8
+
+#define NX_SUBTYPE_EJECT_KEY				10
+#define NX_SUBTYPE_SLEEP_EVENT				11
+#define NX_SUBTYPE_RESTART_EVENT			12
+#define NX_SUBTYPE_SHUTDOWN_EVENT			13
