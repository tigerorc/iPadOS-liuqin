+kern_return_t
+IMPL(IOHIDDevice, _Start)
+{
+    setProperty(kIOHIDDKStartKey, kOSBooleanTrue);
+    
+    bool ret = start(provider);
+    
+    return ret ? kIOReturnSuccess : kIOReturnError;
+}
