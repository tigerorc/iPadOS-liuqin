+IOHIDElementPrivate *IOHIDElementPrivate::nullElement(IOHIDElementContainer *owner,
+                                                      UInt32 reportID,
+                                                      IOHIDElementPrivate *parent)
+{
+    IOHIDElementPrivate *element = new IOHIDElementPrivate;
