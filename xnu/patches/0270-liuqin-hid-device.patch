+{
+    OSDeclareDefaultStructors(IOHIDDeviceElementContainer)
+    
+private:
+    struct ExpansionData {
+        IOHIDDevice     *owner;
+    };
+    
+    ExpansionData       *_reserved;
+    
+protected:
+    virtual bool init(void *descriptor, IOByteCount length, IOHIDDevice *owner);
