+/*
+	File:		HIDGetNextButtonInfo.c
+
+	Contains:	HIDGetNextButtonInfo call for HID Library
+
+	Version:	1.0d1
+
+	Copyright:	� 2000 by Apple Computer, Inc., all rights reserved.
