+
+bool  isSingleUser ()
+{
+    char namep[16];
+    static int singleUser;
+    
+    if (!singleUser) {
+        if (PE_parse_boot_argn("-s", namep, sizeof (namep))) {
+            singleUser |= 0x1;
+        }
+        singleUser |= 0x2;
+    }
+    return singleUser & 0x1;
+}
