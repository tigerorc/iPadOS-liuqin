+if (!isInactive() && _commandGate) {         \
+    _commandGate->runActionBlock(^IOReturn{  \
+        if (isInactive()) {                  \
+            return kIOReturnOffline;         \
+        };                                   \
+        b                                    \
+        return kIOReturnSuccess;             \
+    });                                      \
