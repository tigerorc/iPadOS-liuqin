+kern_return_t
+IMPL(IOHIDInterface, Open)
+{
+    __block bool result = false;
+    
+    dispatch_workloop_sync({
+        result = openGated(forClient, options, action);
+    });
+    
+    return result ? kIOReturnSuccess : kIOReturnError;
