+/*
+	File:		HIDProcessMainItem.c
+
+	Contains:	xxx put contents here xxx
+
+	Version:	xxx put version here xxx
+
+	Copyright:	� 1999 by Apple Computer, Inc., all rights reserved.
+
+	File Ownership:
+
