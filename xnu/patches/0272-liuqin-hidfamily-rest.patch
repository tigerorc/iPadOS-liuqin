+	for (i=0; i<(int)ptPreparsedData->reportItemCount; i++)
+	{
+		ptReportItem = &ptPreparsedData->reportItems[i];
+		switch (ptReportItem->reportType)
+		{
+			case kHIDInputReport:
+				if (HIDIsButton(ptReportItem, preparsedDataRef))
