--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5572,6 +5572,94 @@
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+#if defined(ARM64_BOARD_CONFIG_LIUQIN)
+/*
+ * Bring-up aid: kern.exec_inject holds "LIBRARY NAME NAME ..." groups separated
+ * by ";".  Every program whose file name is one of the NAMEs is started with
+ * DYLD_INSERT_LIBRARIES=LIBRARY in its environment, so dyld loads our library
+ * into it.  A program named in more than one group gets every one of those
+ * libraries, joined with ":" in the single DYLD_INSERT_LIBRARIES.
+ *
+ * launchd refuses to pass DYLD_* variables from a job description to a system
+ * daemon (libsystem's posix_spawn strips DYLD_INSERT_LIBRARIES specifically,
+ * while leaving other DYLD_* alone), which is why the kernel has to add this
+ * one.  The mechanism is hackios's (oosexgang/hackios-xnu-kernel,
+ * xnu/hakios.patch), which established that the window server can be reached
+ * this way without replacing it.
+ *
+ * liuqin_dylib.c sets this once, after the root is mounted and the library has
+ * been written to a writable directory, which happens well before launchd
+ * starts backboardd.
+ */
+static char exec_inject_conf[512];
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED,
+    exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [; LIBRARY NAME...]: programs started with the library inserted");
+
+extern void liuqin_exec_inject_set(const char *conf);
+
+void
+liuqin_exec_inject_set(const char *conf)
+{
+	if (conf == NULL) {
+		exec_inject_conf[0] = '\0';
+		return;
+	}
+	strlcpy(exec_inject_conf, conf, sizeof(exec_inject_conf));
+	printf("LIUQIN INJECT: \"%s\"\n", exec_inject_conf);
+}
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p = exec_inject_conf;
+	size_t namelen, used;
+	bool any = false;
+
+	if (*p == '\0' || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != '\0') {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		library = p;
+		while (*p != '\0' && *p != ' ' && *p != ';') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+
+			while (*p != '\0' && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 &&
+			    liblen != 0 && strncmp(word, name, namelen) == 0) {
+				matched = true;         /* this group names this program */
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';      /* dyld takes ":"-separated libraries */
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = '\0';
+			any = true;
+		}
+	}
+	return any;
+}
+#endif /* ARM64_BOARD_CONFIG_LIUQIN */
+
