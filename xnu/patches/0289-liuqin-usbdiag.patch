+/* LIUQIN: USB bring-up stage tracker and its shout loop (see liuqin_usb_probe). */
+/*
+ * LIUQIN: the USB bring-up is the only channel that would make the console
+ * readable without photographing the screen, and it has never enumerated on
+ * hardware.  A single line at boot is impossible to catch on a phone lying on
+ * a desk, so this build keeps shouting: a thread prints the stage the probe
+ * reached and the live register values once a second, for ever, and forces the
+ * console unmuted so liuqinmute cannot hide it.
+ *
+ * liuqinusbdiag=0 turns it off.  Stage numbers, in order:
+ *   0 boot, 1 arg read, 2 GCC mapped, 3 clocks on, 4 DWC3 mapped,
+ *   5 PHY checked, 6 soft reset done, 7 ep0 up, 8 running,
+ *   9 ECM endpoints, 10 ue0 up, 11 configured by the host
+ */
+static void
+usb_diag_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	extern int liuqin_console_force;
+	int chan;
+	uint32_t n = 0;
+
+	for (;;) {
+		uint32_t stage = usb_stage;
+		const char *what = usb_last_what;
+		uint32_t err = usb_last_errno;
+		uint32_t gdscr = 0, gctl = 0, dcfg = 0, dctl = 0, dsts = 0, dalep = 0;
+
+		if (ud.dwc != 0) {
+			gctl = dwc_rd(GCTL);
+			dcfg = dwc_rd(DCFG);
+			dctl = dwc_rd(DCTL);
+			dsts = dwc_rd(DSTS);
+			dalep = dwc_rd(DALEPENA);
+		}
+		liuqin_console_force = 1;
+		printf("LIUQIN USBDIAG %u: stage %u (%s) err %u | GCTL %08x DCFG %08x "
+		    "DCTL %08x DSTS %08x DALEPENA %08x | ifp %p dma_pa %llx events %u "
+		    "configured %d rx %llu tx %llu\n",
+		    n++, stage, what ? what : "?", err,
+		    gctl, dcfg, dctl, dsts, dalep,
+		    (void *)ud.ifp, (unsigned long long)ud.dma_pa, ud.events,
+		    (int)ud.configured,
+		    (unsigned long long)ud.rx_frames, (unsigned long long)ud.tx_frames);
+		liuqin_console_force = 0;
+		(void)tsleep(&chan, PZERO, "usbdiag", 1 * hz);
+	}
+}
+
+static void
+usb_diag_start(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("liuqinusbdiag", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (kernel_thread_start(usb_diag_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
