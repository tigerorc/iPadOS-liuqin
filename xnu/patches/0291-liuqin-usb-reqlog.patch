--- a/bsd/dev/liuqin_usb.c
+++ b/bsd/dev/liuqin_usb.c
@@ -152,6 +152,9 @@
 
 /* LIUQIN: USB bring-up stage tracker (defined at the end of this file). */
 static void usb_diag_start(void);
+#define USB_REQ_LOG 32
+static volatile uint32_t usb_req_log[USB_REQ_LOG];
+static volatile uint32_t usb_req_log_count;
 static volatile uint32_t usb_stage;
 static volatile uint32_t usb_last_errno;
 static const char *volatile usb_last_what = "boot";
@@ -578,7 +581,20 @@
 	uint32_t n = 0;
 	bool ok = true;
 
-	printf("LIUQIN USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	/*
+	 * Every control request, in order.  The Windows NCM driver fails its
+	 * start without saying why, so the request it stops after - and whether
+	 * we stalled it - is the only way to see where it gives up.
+	 */
+	{
+		static uint32_t nreq;
+		usb_req_log[nreq & (USB_REQ_LOG - 1)] =
+		    ((uint32_t)type << 24) | ((uint32_t)req << 16) | (length & 0xffffu);
+		usb_req_log_count = ++nreq;
+	}
+	printf("LIUQIN USB: setup #%u %02x %02x %04x %04x len %u
+",
+	    usb_req_log_count, type, req, value, index, length);
 	ud.data_in = (type & 0x80) != 0;
 	if ((type & 0x60) == 0x20) {
 		/*
@@ -1285,6 +1301,26 @@
 		    (void *)ud.ifp, (unsigned long long)ud.dma_pa, ud.events,
 		    (int)ud.configured,
 		    (unsigned long long)ud.rx_frames, (unsigned long long)ud.tx_frames);
+		/*
+		 * The control requests the host has sent, oldest first.  The last one
+		 * it made is the one the driver stopped after.
+		 */
+		{
+			uint32_t total = usb_req_log_count;
+			uint32_t show = total < USB_REQ_LOG ? total : USB_REQ_LOG;
+			uint32_t start = total - show;
+
+			if (show) {
+				printf("LIUQIN USBREQ %u: last %u of %u:", n, show, total);
+				for (uint32_t k = 0; k < show; k++) {
+					uint32_t e = usb_req_log[(start + k) & (USB_REQ_LOG - 1)];
+					printf(" %02x.%02x/%u", (e >> 24) & 0xff, (e >> 16) & 0xff,
+					    e & 0xffff);
+				}
+				printf("
+");
+			}
+		}
 		liuqin_console_force = 0;
 		(void)tsleep(&chan, PZERO, "usbdiag", 1 * hz);
 	}
